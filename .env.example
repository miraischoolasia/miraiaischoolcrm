VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional: the shared WhatsApp inbox (Chatwoot). The WhatsApp page stays hidden until this is set.
VITE_CHATWOOT_URL=
# Optional: where the school inbox page reads and sends chats through (a gateway that holds the Chatwoot key).
VITE_WHATSAPP_API_URL=

# Optional brand of this deployment. Left empty, the CRM shows Mirai AI School.
VITE_BRAND_NAME=
VITE_BRAND_COMPANY=
# A full address of a logo picture. Empty (with a brand name set): the name is shown as text.
VITE_BRAND_LOGO_URL=

# Optional features of this deployment, off unless set to true (see src/lib/features.ts).
# VITE_FEATURE_<NAME>=true
